# Production Environment Configuration Blueprint (Hetzner VPS + Remote PostgreSQL)

APP_DOMAIN=www.winiq.com
APP_BASE_URL=https://www.winiq.com
NODE_ENV=production

# Remote PostgreSQL with TLS required
DATABASE_URL=postgresql://user:password@remote-db-host:5432/bet_project?sslmode=require

# Data providers
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_SEASON=2026

# Persistent paths inside container (mounted from volume)
PRODUCTION_DATA_ROOT=/srv/bet-project-data
PRODUCTION_BACKUP_DIR=/srv/bet-project-data/backups/production
PRODUCTION_REPORT_DIR=/srv/bet-project-data/reports/production
PRODUCTION_HEALTH_STATE_PATH=/srv/bet-project-data/data/operations/model-health-state.json
PRODUCTION_HEALTH_LOG_PATH=/srv/bet-project-data/logs/production/model-health-events.jsonl
PRODUCTION_NOTIFICATION_DIR=/srv/bet-project-data/notifications/production

# Production deployment safety controls
PRODUCTION_DEPLOYMENT_PROVIDER=SELF_HOSTED
PRODUCTION_DEPLOYMENT_APPROVED=false
PRODUCTION_DEPLOYMENT_APPROVAL_ID=DEPLOY-20261023-MANUAL01
PRODUCTION_RELEASE_ID=V4.3-PROD001
PRODUCTION_ROLLBACK_CONFIRMED=false
PRODUCTION_POST_DEPLOY_HEALTH_CHECK=false
PRODUCTION_NOTIFICATION_DELIVERY_ENABLED=false
